generator client {
  provider     = "prisma-client"
  moduleFormat = "cjs"
  output       = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HistoricalEvent {
  id             String                @id
  name           String
  date           DateTime              @db.Date
  timeZone       String
  volunteerCount Int
  roleTotals     HistoricalRoleTotal[]
  intervals      HistoricalInterval[]
}

model HistoricalRoleTotal {
  eventId        String
  role           String
  volunteerCount Int
  event          HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, role])
}

model HistoricalInterval {
  eventId  String
  ordinal  Int
  startsAt DateTime        @db.Timestamptz(0)
  endsAt   DateTime        @db.Timestamptz(0)
  event    HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, ordinal])
}

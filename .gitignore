# Keep shared agent skills and roles; ignore local settings and worktrees.
.claude/*
!.claude/skills/
!.claude/agents/
.claude/worktrees/
.agents/*
!.agents/skills/
.codex/*
!.codex/agents/
.codex/worktrees/
# Local credentials are never shared.
.aws/
/.env
/.env.resend.local

# Backend build artifacts and local configuration.
/backend/node_modules/
/backend/dist/
/backend/src/generated/prisma/
/backend/.env

generator client {
  provider     = "prisma-client"
  moduleFormat = "cjs"
  output       = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HistoricalEvent {
  id             String                @id
  name           String
  date           DateTime              @db.Date
  timeZone       String
  volunteerCount Int
  roleTotals     HistoricalRoleTotal[]
  intervals      HistoricalInterval[]
}

model HistoricalRoleTotal {
  eventId        String
  role           String
  volunteerCount Int
  event          HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, role])
}

model HistoricalInterval {
  eventId  String
  ordinal  Int
  startsAt DateTime        @db.Timestamptz(0)
  endsAt   DateTime        @db.Timestamptz(0)
  event    HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, ordinal])
}

enum IdentityRole {
  VOLUNTEER
  COORDINATOR
  ADMIN
}

enum IdentityChallengePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  ACTIVATE_STAFF
}

enum IdentityMailState {
  PENDING
  SENT
  EXPIRED
  REVIEW
}

enum IdentityLoginKind {
  ACCOUNT
  IP
}

model IdentityAccount {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String
  email            String              @unique
  passwordHash     String?
  role             IdentityRole
  locale           String
  emailVerifiedAt  DateTime?           @db.Timestamptz(3)
  activatedAt      DateTime?           @db.Timestamptz(3)
  disabledAt       DateTime?           @db.Timestamptz(3)
  approvedAt       DateTime?           @db.Timestamptz(3)
  canApprove       Boolean             @default(false)
  profile          IdentityProfile?
  sessions         IdentitySession[]
  challenges       IdentityChallenge[]
  planningEvents   PlanningCoordinator[]
  availability     VolunteerAvailability?
  trainingPermit   TrainingPermission?
  trainings        TrainingRecord[]
  verification     VolunteerIdentityVerification?
  participationRequests ParticipationRequest[]

  @@index([organizationId, role])
}

model IdentityProfile {
  accountId String          @id @db.Uuid
  firstName String?
  lastName  String?
  birthDate DateTime?       @db.Date
  phone     String?
  locality  String?
  account   IdentityAccount @relation(fields: [accountId], references: [id])
}

model IdentitySession {
  digest     String          @id
  accountId  String          @db.Uuid
  createdAt  DateTime        @db.Timestamptz(3)
  lastSeenAt DateTime        @db.Timestamptz(3)
  account    IdentityAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

model IdentityChallenge {
  id         String                   @id @default(uuid()) @db.Uuid
  accountId  String                   @db.Uuid
  purpose    IdentityChallengePurpose
  createdAt  DateTime                 @db.Timestamptz(3)
  expiresAt  DateTime                 @db.Timestamptz(3)
  consumedAt DateTime?                @db.Timestamptz(3)
  account    IdentityAccount          @relation(fields: [accountId], references: [id])
  mail       IdentityMailJob?

  @@index([accountId, purpose, expiresAt])
}

model IdentityMailJob {
  id          String            @id @db.Uuid
  state       IdentityMailState @default(PENDING)
  attempts    Int               @default(0)
  availableAt DateTime          @db.Timestamptz(3)
  leaseUntil  DateTime?         @db.Timestamptz(3)
  challenge   IdentityChallenge @relation(fields: [id], references: [id])

  @@index([state, availableAt])
}

model IdentityLoginBucket {
  key          String            @id
  kind         IdentityLoginKind
  attempts     Int               @default(0)
  expiresAt    DateTime          @db.Timestamptz(3)
  blockedUntil DateTime?         @db.Timestamptz(3)

  @@index([expiresAt])
}

model IdentityAudit {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  targetId   String   @db.Uuid
  action     String
  occurredAt DateTime @db.Timestamptz(3)

  @@index([targetId, occurredAt])
}

model PlanningEvent {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String
  title          String?
  description    String?
  publishedAt    DateTime?             @db.Timestamptz(3)
  coordinators   PlanningCoordinator[]
  locations      PlanningLocation[]
  shifts         PlanningShift[]
  participationRequests ParticipationRequest[]

  @@index([organizationId, publishedAt])
}

model PlanningCoordinator {
  eventId   String          @db.Uuid
  accountId String          @db.Uuid
  revokedAt DateTime?       @db.Timestamptz(3)
  event     PlanningEvent   @relation(fields: [eventId], references: [id])
  account   IdentityAccount @relation(fields: [accountId], references: [id])

  @@id([eventId, accountId])
  @@index([accountId, revokedAt])
}

model PlanningLocation {
  id      String          @id @default(uuid()) @db.Uuid
  eventId String          @db.Uuid
  name    String
  address String?
  event   PlanningEvent   @relation(fields: [eventId], references: [id])
  shifts  PlanningShift[]

  @@unique([eventId, id])
}

model PlanningShift {
  id         String              @id @default(uuid()) @db.Uuid
  eventId    String              @db.Uuid
  locationId String?             @db.Uuid
  startsAt   DateTime?           @db.Timestamptz(3)
  endsAt     DateTime?           @db.Timestamptz(3)
  event      PlanningEvent       @relation(fields: [eventId], references: [id])
  location   PlanningLocation?   @relation(fields: [eventId, locationId], references: [eventId, id], onDelete: Restrict)
  canceledAt DateTime? @db.Timestamptz(3)
  breaks     PlanningBreak[]
  positions  PlanningPosition[]

  @@index([eventId, startsAt])
}

model PlanningBreak {
  id       String        @id @default(uuid()) @db.Uuid
  shiftId  String        @db.Uuid
  startsAt DateTime      @db.Timestamptz(3)
  endsAt   DateTime      @db.Timestamptz(3)
  shift    PlanningShift @relation(fields: [shiftId], references: [id])

  @@index([shiftId, startsAt])
}

model PlanningRole {
  id                       String             @id
  organizationId           String
  name                     String
  minimumAge               Int
  specializedTraining      Boolean
  supervisionForMinors     Boolean
  positions                PlanningPosition[]
  trainings                TrainingRole[]

  @@index([organizationId])
}

model PlanningPosition {
  id                     String        @id @default(uuid()) @db.Uuid
  shiftId                String        @db.Uuid
  roleId                 String
  capacity               Int
  tasks                  String?
  adequacyConfirmedAt    DateTime?     @db.Timestamptz(3)
  adequacyConfirmedBy    String?       @db.Uuid
  supervisionConfirmedAt DateTime?    @db.Timestamptz(3)
  supervisionConfirmedBy String?      @db.Uuid
  shift                  PlanningShift @relation(fields: [shiftId], references: [id])
  role                   PlanningRole  @relation(fields: [roleId], references: [id])
  placements             ParticipationPlacement[]

  @@unique([shiftId, roleId])
}

model PlanningPolicy {
  organizationId        String @id
  breakThresholdMinutes Int
  minimumBreakMinutes   Int
  offerDurationMinutes  Int @default(720)
}

model PlanningAudit {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @db.Uuid
  actorId    String?  @db.Uuid
  targetId   String   @db.Uuid
  action     String
  reason     String?
  occurredAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([eventId, occurredAt])
}

model VolunteerAvailability {
  accountId  String          @id @db.Uuid
  weekly     Json
  exceptions Json
  account    IdentityAccount @relation(fields: [accountId], references: [id])
}

model TrainingPermission {
  accountId String          @id @db.Uuid
  account   IdentityAccount @relation(fields: [accountId], references: [id])
}

enum TrainingType {
  GENERAL
  SPECIALIZED
}

enum TrainingAction {
  CONFIRMED
  RENEWAL_REQUESTED
  CANCELED
}

model TrainingRecord {
  id          String          @id @default(uuid()) @db.Uuid
  accountId   String          @db.Uuid
  type        TrainingType
  domain      String
  trainer     String
  completedOn DateTime        @db.Date
  confirmedBy String          @db.Uuid
  confirmedAt DateTime        @db.Timestamptz(3)
  canceledAt  DateTime?       @db.Timestamptz(3)
  renewalRequestedAt DateTime? @db.Timestamptz(3)
  supersededById String?       @unique @db.Uuid
  supersededBy TrainingRecord? @relation("TrainingRenewal", fields: [supersededById], references: [id])
  supersedes   TrainingRecord? @relation("TrainingRenewal")
  account     IdentityAccount @relation(fields: [accountId], references: [id])
  roles       TrainingRole[]
  history     TrainingOperation[]

  @@index([accountId, canceledAt])
}

model TrainingRole {
  recordId String         @db.Uuid
  roleId   String
  record   TrainingRecord @relation(fields: [recordId], references: [id])
  role     PlanningRole   @relation(fields: [roleId], references: [id])

  @@id([recordId, roleId])
}

model TrainingOperation {
  id         String         @id @default(uuid()) @db.Uuid
  recordId   String         @db.Uuid
  eventId    String         @db.Uuid
  actorId    String         @db.Uuid
  action     TrainingAction
  occurredAt DateTime       @db.Timestamptz(3)
  reason     String?
  record     TrainingRecord @relation(fields: [recordId], references: [id])

  @@index([recordId, occurredAt])
}

enum IdentityVerificationResult {
  VERIFIED
  REJECTED
}

model VolunteerIdentityVerification {
  accountId     String                     @id @db.Uuid
  result        IdentityVerificationResult
  verifiedAt    DateTime                   @db.Timestamptz(3)
  verifierId    String                     @db.Uuid
  invalidatedAt DateTime?                  @db.Timestamptz(3)
  account       IdentityAccount            @relation(fields: [accountId], references: [id])
}

enum EligibilityReviewReason {
  IDENTITY_INVALIDATED
  TRAINING_CANCELED
  SHIFT_DATE_CHANGED
  POSITION_TASKS_CHANGED
  SUPERVISION_WITHDRAWN
  AVAILABILITY_CHANGED
  TRAINING_CHANGED
  POSITION_REQUIREMENTS_RESTORED
}

model EligibilityReview {
  id         String                  @id @default(uuid()) @db.Uuid
  subjectId  String                  @db.Uuid
  reason     EligibilityReviewReason
  createdAt  DateTime                @default(now()) @db.Timestamptz(3)

  processedAt DateTime? @db.Timestamptz(3)

  @@index([createdAt])
  @@index([subjectId])
  @@index([processedAt, createdAt])
}

enum PlacementState {
  PROPOSED
  QUEUED
  SUSPENDED
  OFFERED
  CONFIRMED
  DECLINED
  EXPIRED
  WITHDRAWN
  CANCELED
  REPLACED
}

enum ParticipationJobKind {
  POSITION
  EVENT
}

model ParticipationRequest {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  accountId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)
  event PlanningEvent @relation(fields: [eventId], references: [id])
  account IdentityAccount @relation(fields: [accountId], references: [id])
  placements ParticipationPlacement[]

  @@index([eventId, closedAt])
  @@index([accountId, closedAt])
}

model ParticipationPlacement {
  id String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  positionId String @db.Uuid
  proposedBy String @db.Uuid
  replacesId String? @db.Uuid
  state PlacementState @default(PROPOSED)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  queueOrder BigInt?
  expiresAt DateTime? @db.Timestamptz(3)
  reviewIssues String[] @default([])
  request ParticipationRequest @relation(fields: [requestId], references: [id])
  position PlanningPosition @relation(fields: [positionId], references: [id])
  replaces ParticipationPlacement? @relation("Replacement", fields: [replacesId], references: [id])
  replacements ParticipationPlacement[] @relation("Replacement")

  @@index([positionId, state, queueOrder])
  @@index([requestId, state])
}

model ParticipationJob {
  kind ParticipationJobKind
  targetId String @db.Uuid
  dueAt DateTime @db.Timestamptz(3)

  @@id([kind, targetId])
  @@index([dueAt])
}

model ParticipationNotice {
  id BigInt @id @default(autoincrement())
  accountId String @db.Uuid
  eventId String @db.Uuid
  subjectId String @db.Uuid
  kind String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([accountId, id])
}

# Use distinct values from: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_bootstrap_password
MIGRATOR_PASSWORD=replace_with_migrator_password
APP_PASSWORD=replace_with_application_password

# Identity is enabled after setting an HTTPS origin and a distinct 32-byte hex secret.
IDENTITY_PUBLIC_URL=
IDENTITY_SECRET=
# Regular local Compose starts with delivery disabled. The integration suite uses simulation.
# For manual local Resend setup, see “Testare locală cu Resend” in README.md.
IDENTITY_MAIL_TRANSPORT=disabled
IDENTITY_MAIL_FROM=
RESEND_API_KEY=
# Explicit proxy IPs or CIDRs, only when this app runs behind a trusted proxy.
IDENTITY_TRUSTED_PROXIES=
